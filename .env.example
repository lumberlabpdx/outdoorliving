# Copy to .env and fill in from your Supabase project (dashboard → Project Settings → API).
# The publishable key is safe to expose: it ships in the site's JavaScript, and row-level
# security limits it to submitting the contact form.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
